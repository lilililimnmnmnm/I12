<Window x:Class="Test.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i12="clr-namespace:I12;assembly=I12"
        Title="MainWindow" Height="320" Width="640" Background="#FF323232">
    <StackPanel Orientation="Horizontal">
        <StackPanel>
            <Border Width="38" Height="38" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon32 Icon="{x:Static i12:I12Icon32Convert1.IconSource}"/>
            </Border>
        </StackPanel>
        <StackPanel>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Patient1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Box1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Image1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Directory1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24History1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Setting1.IconSource}"/>
            </Border>
        </StackPanel>
        <StackPanel>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Wait1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Skip1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Success1.IconSource}"/>
            </Border>
            <Border Width="32" Height="32" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="2">
                <i12:I12Icon24 Icon="{x:Static i12:I12Icon24Failure1.IconSource}"/>
            </Border>
        </StackPanel>
        <StackPanel>
            <Border Width="24" Height="24" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16FilterCancel1.IconSource}"/>
            </Border>
            <Border Width="24" Height="24" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16Calendar1.IconSource}"/>
            </Border>
            <Border Width="24" Height="24" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16Box1.IconSource}"/>
            </Border>
            <Border Width="24" Height="24" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16Image1.IconSource}"/>
            </Border>
            <Border Width="24" Height="24" Background="#FFF0F0F0" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16Directory1.IconSource}"/>
            </Border>
        </StackPanel>
        <StackPanel>
            <Border Width="24" Height="24" Background="#FF323232" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16User1.IconSource}"/>
            </Border>
            <Border Width="24" Height="24" Background="#FF323232" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16Password1.IconSource}"/>
            </Border>
            <Border Width="24" Height="24" Background="#FF323232" BorderBrush="#FF969696" BorderThickness="1" Margin="2" Padding="3">
                <i12:I12Icon16 Icon="{x:Static i12:I12Icon16Login1.IconSource}"/>
            </Border>
        </StackPanel>
    </StackPanel>
</Window>
